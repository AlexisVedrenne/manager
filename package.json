{
  "name": "manager",
  "version": "0.0.1",
  "description": "L'objectif de cette application est de faciliter la vie à tous ceux qui voudrons l'utiliser. Je voulais créer quelque de chose d'utilisable facilement et de façon intuitive. Pour que ceux qui comme moi on du mal à gérer leur quotidien et qui on besoin d'aide pour l'organiser un peu mieux chaque jours.",
  "productName": "Manager",
  "author": "Alexis <alexisvedrenne482@gmail.com>",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.vue ./",
    "dev": "cross-env QENV=DEV quasar dev",
    "build": "cross-env QENV=DEV quasar build",
    "android": "cross-env QENV=DEV quasar dev -m cordova -T android",
    "buildAndroid": "cross-env QENV=DEV quasar build -m cordova -T android",
    "windows": "cross-env QENV=DEV quasar dev -m electron",
    "buildWindows": "cross-env QENV=DEV quasar build -m electron",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0"
  },
  "dependencies": {
    "@quasar/extras": "^1.0.0",
    "core-js": "^3.6.5",
    "cross-env": "^7.0.3",
    "easytimer.js": "^4.5.3",
    "firebase": "^9.6.10",
    "quasar": "^2.6.0",
    "vue": "3.2.31",
    "vue-router": "^4.0.0",
    "vuex": "^4.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.13.14",
    "@quasar/app-webpack": "^3.0.0",
    "dotenv": "^16.0.0",
    "electron": "^18.1.0",
    "electron-packager": "^15.2.0",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^8.5.0",
    "eslint-webpack-plugin": "^3.1.1",
    "prettier": "^2.5.1"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "engines": {
    "node": ">= 12.22.1",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
